{
  "name": "@old-st/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "tokens:gen": "node scripts/generate-css-tokens.mjs",
    "tokens:check": "node scripts/check-css-tokens.mjs",
    "tokens:sync": "node scripts/sync-figma-tokens.mjs",
    "docs:masterclass:gen": "node scripts/masterclass/build.mjs && node scripts/masterclass/build-fe-webapp.mjs",
    "docs:masterclass:check": "node scripts/check-masterclass-docs.mjs",
    "audit:ai-config": "node scripts/audit-ai-config.mjs",
    "icons:add": "python3 packages/ui/src/icons/svg-to-icons.py",
    "figma:audit-icons": "node scripts/audit-figma-icons.mjs",
    "test": "nx run-many --target=test --all",
    "test:watch": "nx test --watch",
    "test:coverage": "nx run-many --target=test --all --coverage",
    "test:domain": "nx run-many --target=test --projects=*-domain --parallel=3",
    "test:unit": "nx run-many --target=test --all --exclude=*integration* --exclude=*e2e*",
    "test:integration": "echo 'No domain integration tests in base template. See examples/ for integration test references.' && exit 0",
    "test:e2e": "nx run-many --target=e2e --all",
    "test:e2e:api": "nx run-many --target=e2e --all --exclude=webapp-e2e",
    "test:e2e:webapp": "nx e2e webapp-e2e",
    "test:e2e:webapp:headed": "nx e2e webapp-e2e -- --headed",
    "test:e2e:webapp:ui": "nx e2e webapp-e2e -- --ui",
    "e2e:setup": "ts-node --project scripts/tsconfig.json scripts/setup-e2e.ts",
    "e2e:setup:force": "ts-node --project scripts/tsconfig.json scripts/setup-e2e.ts --force",
    "e2e:teardown": "ts-node --project scripts/tsconfig.json scripts/teardown-e2e.ts",
    "e2e:local": "ts-node --project scripts/tsconfig.json scripts/e2e-local.ts",
    "e2e:local:webapp": "ts-node --project scripts/tsconfig.json scripts/e2e-local.ts --webapp",
    "e2e:local:quick": "ts-node --project scripts/tsconfig.json scripts/e2e-local.ts --skip-build",
    "dynamo:status": "docker compose ps",
    "dynamo:start": "docker compose up -d",
    "dynamo:stop": "docker compose down",
    "dynamo:clean": "docker compose down -v",
    "localstack:setup": "ts-node --project scripts/tsconfig.json scripts/setup-localstack.ts",
    "localstack:setup:force": "ts-node --project scripts/tsconfig.json scripts/setup-localstack.ts --force",
    "localstack:status": "ts-node --project scripts/tsconfig.json scripts/setup-localstack.ts --status",
    "prisma:migrate:all": "ts-node --project scripts/tsconfig.json scripts/prisma-migrate-all.ts",
    "prisma:generate:all": "ts-node --project scripts/tsconfig.json scripts/prisma-generate-all.ts",
    "validate:node": "ts-node --project scripts/tsconfig.json scripts/validate-node-version.ts",
    "lint:standards": "ts-node --project scripts/tsconfig.json scripts/lint-standards.ts",
    "ci:local:quick": "pnpm tokens:check && nx affected --target=lint --parallel=3 && nx affected --target=build --parallel=3 --exclude=mobile,monitoring-webapp && pnpm lint:standards && nx affected --target=test --parallel=3",
    "prepare": "husky"
  },
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
