# =============================================================================
# CI Service Registry — per-service E2E environment variables
# =============================================================================
# Sourced in ci-e2e.yml and ci-test-all.yml via:
#   cat .github/service-registry.env >> $GITHUB_ENV
#
# When adding a NEW HTTP API service, add a section below following the
# same pattern. For DynamoDB domains add a *_DYNAMODB_TABLE_NAME entry;
# for Prisma domains add a *_DATABASE_URL entry.
# Also add an entry to .github/service-registry.json (build + start).
#
# Example domain env vars (USER/PRODUCT/ORDER) live in the example workspace
# at examples/ — they are NOT loaded into the main pipeline.
# =============================================================================

# --- Auth domain (Cognito — uses local provider in CI) ---
AUTH_SERVICE_PORT=3003
API_AUTH_URL=http://localhost:3003/api
NEXT_PUBLIC_API_AUTH_URL=http://localhost:3003/api
# JWT_JWKS_URI and JWT_ISSUER are not needed in local/CI mode (STAGE=local skips JWKS verification).
# Set these to your provider's values for deployed environments via Terraform.
JWT_JWKS_URI=
JWT_ISSUER=
JWT_USER_ID_CLAIM=custom:userId
JWT_USER_ROLE_CLAIM=custom:userRole

# --- File domain (S3 presigned URLs + CloudFront signed downloads) ---
FILE_SERVICE_PORT=3004
API_FILE_URL=http://localhost:3004/api
NEXT_PUBLIC_API_FILE_URL=http://localhost:3004/api
FILES_S3_BUCKET_NAME=old-st-files-e2e
CLOUDFRONT_DOMAIN=
CLOUDFRONT_KEY_PAIR_ID=
CLOUDFRONT_PRIVATE_KEY=
