{
  "version": "2.0.0",
  "tasks": [
    // ── Validation ────────────────────────────────────────────────────────────
    {
      "label": "Node: Validate Version",
      "type": "shell",
      "command": "node scripts/ensure-node.js pnpm run validate:node",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "CI: Local Check (affected lint + test + lint-standards)",
      "detail": "Mirror of ci-fast-check + ci-test-affected — run before pushing to catch failures early",
      "type": "shell",
      "command": "pnpm ci:local:quick",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": [],
      "options": {
        "env": {
          "NX_TUI": "false"
        }
      }
    },

    // ── Docker / LocalStack ───────────────────────────────────────────────────
    {
      "label": "Docker: Start LocalStack",
      "type": "shell",
      "command": "docker compose up -d",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "Docker: Stop LocalStack",
      "type": "shell",
      "command": "docker compose down",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Docker: Logs (LocalStack)",
      "type": "shell",
      "command": "docker compose logs -f localstack",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": [],
      "isBackground": true
    },
    {
      "label": "Docker: Wipe Data",
      "type": "shell",
      "command": "docker compose down -v",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "LocalStack: Create Tables",
      "type": "shell",
      "command": "node scripts/ensure-node.js pnpm run localstack:setup",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "LocalStack: Force Recreate Tables",
      "type": "shell",
      "command": "node scripts/ensure-node.js pnpm run localstack:setup:force",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "LocalStack: Start + Setup",
      "dependsOn": [
        "Docker: Start LocalStack",
        "LocalStack: Create Tables"
      ],
      "dependsOrder": "sequence",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "DB: Migrate All",
      "type": "shell",
      "command": "node scripts/ensure-node.js pnpm run prisma:migrate:all",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },

    // ── Infra: Start All ──────────────────────────────────────────────────────
    // Validates Node version, starts Docker/LocalStack, runs DB migrations.
    // Safe to run multiple times — all steps are idempotent.
    {
      "label": "Infra: Start All",
      "dependsOn": [
        "Node: Validate Version",
        "LocalStack: Start + Setup",
        "DB: Migrate All"
      ],
      "dependsOrder": "sequence",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },

    // ── Microservices ─────────────────────────────────────────────────────────
    // Add one "Service: Serve {service-name}" task per microservice.
    // Command pattern: npx nx serve {service-name}
    // Claim port in §7.1 of CLAUDE.md before adding.
    {
      "label": "Service: Serve auth-api-service",
      "type": "shell",
      "command": "node scripts/ensure-node.js npx nx serve auth-api-service",
      "isBackground": true,
      "options": {
        "env": {
          "NX_TUI": "false"
        }
      },
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "new"
      },
      "problemMatcher": [
        {
          "pattern": [
            {
              "regexp": ".",
              "file": 1,
              "location": 2,
              "message": 3
            }
          ],
          "background": {
            "activeOnStart": true,
            "beginsPattern": ".",
            "endsPattern": "is running on"
          }
        }
      ]
    },
    {
      "label": "Service: Serve file-api-service",
      "type": "shell",
      "command": "node scripts/ensure-node.js npx nx serve file-api-service",
      "isBackground": true,
      "options": {
        "env": {
          "NX_TUI": "false"
        }
      },
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "new"
      },
      "problemMatcher": [
        {
          "pattern": [
            {
              "regexp": ".",
              "file": 1,
              "location": 2,
              "message": 3
            }
          ],
          "background": {
            "activeOnStart": true,
            "beginsPattern": ".",
            "endsPattern": "is running on"
          }
        }
      ]
    },

    // ── Frontend ──────────────────────────────────────────────────────────────
    {
      "label": "Service: Serve webapp",
      "type": "shell",
      "command": "node scripts/ensure-node.js npx nx dev webapp",
      "isBackground": true,
      "options": {
        "env": {
          "NX_TUI": "false"
        }
      },
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "new"
      },
      "problemMatcher": [
        {
          "pattern": [
            {
              "regexp": ".",
              "file": 1,
              "location": 2,
              "message": 3
            }
          ],
          "background": {
            "activeOnStart": true,
            "beginsPattern": ".",
            "endsPattern": "Ready in"
          }
        }
      ]
    },

    // ── Mobile ─────────────────────────────────────────────────────────────
    {
      "label": "Service: Serve mobile",
      "type": "shell",
      "command": "cd apps/mobile; npx expo start --lan",
      "isBackground": true,
      "options": {
        "env": {
          "EXPO_ROUTER_APP_ROOT": "../../apps/mobile/src/app"
        }
      },
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "new"
      },
      "problemMatcher": []
    },

    // ── Domain-Specific Compound Tasks ────────────────────────────────────────
    // Domain tasks only start services — no infra.
    // Run "Infra: Start All" once per dev session before using these.
    //
    // Example domain compounds (Domain: Start User / Product / Order) live
    // in [examples/.vscode/tasks.json](examples/.vscode/tasks.json) or in git history.
    {
      "label": "Domain: Start Auth",
      "dependsOn": [
        "Service: Serve auth-api-service"
      ],
      "dependsOrder": "parallel",
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Domain: Start Files",
      "dependsOn": [
        "Service: Serve file-api-service"
      ],
      "dependsOrder": "parallel",
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      },
      "problemMatcher": []
    },

    // ── Monitoring (separate concern — not part of Services: Start All) ────────
    {
      "label": "Service: Serve monitoring-api-service",
      "type": "shell",
      "command": "node scripts/ensure-node.js npx nx serve monitoring-api-service",
      "isBackground": true,
      "options": {
        "env": {
          "NX_TUI": "false"
        }
      },
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "new"
      },
      "problemMatcher": [
        {
          "pattern": [
            {
              "regexp": ".",
              "file": 1,
              "location": 2,
              "message": 3
            }
          ],
          "background": {
            "activeOnStart": true,
            "beginsPattern": ".",
            "endsPattern": "is running on"
          }
        }
      ]
    },
    {
      "label": "Service: Serve monitoring-webapp",
      "type": "shell",
      "command": "node scripts/ensure-node.js npx nx dev monitoring-webapp",
      "isBackground": true,
      "options": {
        "env": {
          "NX_TUI": "false"
        }
      },
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "Monitoring: Start All",
      "detail": "Start monitoring API + webapp locally (separate from main services)",
      "dependsOn": [
        "Service: Serve monitoring-api-service",
        "Service: Serve monitoring-webapp"
      ],
      "dependsOrder": "parallel",
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      },
      "problemMatcher": []
    },

    // ── Full Stack ────────────────────────────────────────────────────────────
    // "Services: Start All" launches every service in parallel (no infra).
    // "Dev: Start All" runs infra first, then all services.
    {
      "label": "Services: Start All",
      "dependsOn": [
        "Service: Serve auth-api-service",
        "Service: Serve file-api-service",
        "Service: Serve webapp",
        "Service: Serve mobile"
      ],
      "dependsOrder": "parallel",
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Dev: Start All",
      "dependsOn": [
        "Infra: Start All",
        "Services: Start All"
      ],
      "dependsOrder": "sequence",
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      },
      "problemMatcher": []
    },

