      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Preview: Logs",
      "detail": "Stream logs from the most recent preview workflow run",
      "type": "shell",
      "command": "gh run watch",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": [],
      "isBackground": true
