    {
      "label": "Project: Bootstrap (One-Step)",
      "detail": "After cloning a fresh template repo: rename scope/project/org/CODEOWNERS, delete examples/, commit, push main, create+push develop, apply rulesets + envs. Run ONCE.",
      "type": "shell",
      "command": "node scripts/bootstrap.mjs --scope=${input:initScope} --name=${input:initName} --owner=${input:initOwner} --org=${input:initOrg} \"--display-name=${input:initDisplayName}\" ${input:initKeepExamples} ${input:initSkipRulesets} ${input:initDryRun}",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "Project: Init (Bootstrap from Template)",
      "detail": "DESTRUCTIVE: Renames @mma scope, removes examples/, re-inits git, self-deletes. Run ONCE per new project.",
      "type": "shell",
      "command": "node scripts/init-project.mjs --scope=${input:initScope} --name=${input:initName} --owner=${input:initOwner} ${input:initKeepExamples} ${input:initGitInit} ${input:initDryRun}",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "Template: Remove examples/",
      "detail": "Delete examples/ only. Does NOT touch git, source files, package.json, or CODEOWNERS.",
      "type": "shell",
      "command": "node scripts/remove-examples.mjs ${input:removeExamplesDryRun}",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "destroyEnvironment",
      "type": "pickString",
      "description": "Which environment to DESTROY? (all resources will be deleted)",
      "options": ["dev", "staging", "prod"],
      "default": "dev"
    },
    {
      "id": "credentialsEnv",
      "type": "pickString",
      "description": "Which AWS credential file? (aws-credentials.{env} or fallback to aws-credentials)",
      "options": ["dev", "staging", "prod"],
      "default": "dev"
    },
    {
      "id": "targetEnvironment",
      "type": "pickString",
      "description": "Target GitHub environment for multi-account variable setup",
      "options": ["dev", "staging", "prod"],
      "default": "dev"
    },
    {
      "id": "previewName",
      "type": "promptString",
      "description": "Preview name (lowercase, 3-32 chars, e.g. 'dennis-test' or 'qa-sprint-5')"
    },
    {
      "id": "previewAccount",
      "type": "pickString",
      "description": "Which AWS account to deploy the preview to? (reads vars from this GitHub environment)",
      "options": ["dev", "staging", "prod"],
      "default": "dev"
    },
    {
      "id": "previewBranch",
      "type": "promptString",
      "description": "Branch to deploy (e.g. 'develop', 'feature/payments')",
      "default": "develop"
    },
    {
      "id": "deployEnvironment",
      "type": "pickString",
      "description": "Target environment to deploy to",
      "options": ["dev", "staging", "prod"],
      "default": "dev"
    },
    {
      "id": "deployAll",
      "type": "pickString",
      "description": "Deploy all services? (true = skip affected detection, deploy everything)",
      "options": ["false", "true"],
      "default": "false"
    },
    {
      "id": "enableWebapp",
      "type": "pickString",
      "description": "Deploy webapp (ALB + ECS)? Requires VPC. Adds ~$20/mo.",
      "options": ["false", "true"],
      "default": "false"
    },
    {
      "id": "monitoringDeployEnv",
      "type": "pickString",
      "description": "Target environment for monitoring deployment",
      "options": ["dev", "staging", "prod"],
      "default": "dev"
    },
    {
      "id": "monitoringDeployInfra",
      "type": "pickString",
      "description": "Apply monitoring Terraform (IAM role, state bucket)?",
      "options": ["true", "false"],
      "default": "true"
    },
    {
      "id": "monitoringDeployApi",
      "type": "pickString",
      "description": "Build + deploy monitoring-api-service Lambda?",
      "options": ["true", "false"],
      "default": "true"
    },
    {
      "id": "monitoringDeployWebapp",
      "type": "pickString",
      "description": "Build + deploy monitoring-webapp Lambda?",
      "options": ["true", "false"],
      "default": "true"
    },
    {
      "id": "initOrg",
      "type": "promptString",
      "description": "GitHub org/user (leave blank to auto-detect from origin remote, e.g. Acme-Inc)",
      "default": ""
    },
    {
      "id": "initDisplayName",
      "type": "promptString",
      "description": "Display name shown in UI (leave blank to titleize --name, e.g. \"Acme\")",
      "default": ""
    },
    {
      "id": "initSkipRulesets",
      "type": "pickString",
      "description": "Skip GitHub rulesets + environments? (default: apply them)",
      "options": ["", "--skip-rulesets"],
      "default": ""
    },
    {
      "id": "initScope",
      "type": "promptString",
      "description": "New npm scope (e.g. @acme — must start with @, lowercase)"
    },
    {
      "id": "initName",
      "type": "promptString",
      "description": "New project name (lowercase kebab-case, e.g. acme-platform)"
    },
    {
      "id": "initOwner",
      "type": "promptString",
      "description": "CODEOWNERS team (e.g. @acme/platform — leave blank to keep default)",
      "default": ""
    },
    {
      "id": "initKeepExamples",
      "type": "pickString",
      "description": "Keep examples/ directory? (default: removes it)",
      "options": ["", "--keep-examples"],
      "default": ""
    },
    {
      "id": "initGitInit",
      "type": "pickString",
      "description": "Re-initialize git? (default: yes)",
      "options": ["", "--no-git-init"],
      "default": ""
    },
    {
      "id": "initDryRun",
      "type": "pickString",
      "description": "Dry run? (prints what would change, touches nothing)",
      "options": ["--dry-run", ""],
      "default": "--dry-run"
    },
    {
      "id": "removeExamplesDryRun",
      "type": "pickString",
      "description": "Dry run? (prints what would change, touches nothing)",
      "options": ["--dry-run", "--yes"],
      "default": "--dry-run"
    }
  ]
}
