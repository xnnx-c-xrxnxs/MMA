    // ── AWS Bootstrap (One-Time Account Setup) ────────────────────────────────
    // Run these tasks once per AWS account to create shared infra (S3 state
    // bucket, ECR, GitHub OIDC, IAM deploy role). Requires Terraform CLI.
    //
    // Setup:
    //   Single-account:
    //     1. cp infra/bootstrap/aws-credentials.example infra/bootstrap/aws-credentials
    //     2. Fill in terraform.tfvars + aws-credentials
    //     3. Run "AWS: Bootstrap Apply"
    //
    //   Multi-account (per environment):
    //     1. cp infra/bootstrap/aws-credentials.example infra/bootstrap/aws-credentials.dev
    //     2. Fill aws-credentials.dev with DEV account credentials
    //     3. Repeat for staging/prod
    //     4. Run bootstrap tasks (they prompt for which credential file to use)
    //
    // All credential files are gitignored — they never leave your machine.
    {
      "label": "AWS: Bootstrap Init",
      "type": "shell",
      "command": "node scripts/task-helpers/bootstrap-cmd.mjs ${input:credentialsEnv} init",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "AWS: Bootstrap Plan",
      "type": "shell",
      "command": "node scripts/task-helpers/bootstrap-cmd.mjs ${input:credentialsEnv} plan",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": [],
      "dependsOn": ["AWS: Bootstrap Init"]
    },
    {
      "label": "AWS: Bootstrap Apply",
      "type": "shell",
      "command": "node scripts/task-helpers/bootstrap-cmd.mjs ${input:credentialsEnv} apply",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": [],
      "dependsOn": ["AWS: Bootstrap Init"]
    },
    {
      "label": "AWS: Setup GitHub Repo Variables",
      "detail": "Reads bootstrap Terraform outputs and sets all required GitHub repo variables via gh CLI",
      "type": "shell",
      "command": "node scripts/task-helpers/setup-github-vars.mjs ${input:credentialsEnv}",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "AWS: Setup GitHub Environment Variables",
      "detail": "Reads bootstrap outputs and sets GitHub ENVIRONMENT-scoped variables for multi-account deployment",
      "type": "shell",
      "command": "node scripts/task-helpers/setup-github-env-vars.mjs ${input:targetEnvironment}",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "GitHub: Seed Issue Labels",
      "detail": "Creates/updates the label taxonomy used by AI_ISSUE_CREATOR_PROMPT.md and /triage-sprint",
      "type": "shell",
      "command": "node scripts/task-helpers/setup-github-labels.mjs",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Project: Init Branches",
      "detail": "(One-time, after fresh fork) Create develop from main and push to origin",
      "type": "shell",
      "command": "node scripts/task-helpers/init-branches.mjs",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "GitHub: Setup Branch Protection",
      "detail": "Applies branch protection on main + develop, GitHub environments (dev/staging/prod), tag protection on v*",
      "type": "shell",
      "command": "node scripts/task-helpers/setup-branch-protection.mjs",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "GitHub: Setup Branch Protection (Rename CODEOWNERS Team)",
      "detail": "Same as above + interactively replaces @xnnx-c-xrxnxs/senior-devs in CODEOWNERS with your org/team",
      "type": "shell",
      "command": "node scripts/task-helpers/setup-branch-protection.mjs --rename-codeowners",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },

    // ── Deploy ─────────────────────────────────────────────────────────────────
    // Trigger CD pipeline from the IDE.
    // Requires: gh CLI authenticated (gh auth login) + repo variables set.
    {
      "label": "Deploy: Trigger",
      "detail": "Trigger a CD deployment to the selected environment",
      "type": "shell",
      "command": "node scripts/task-helpers/deploy-trigger.mjs ${input:deployEnvironment} ${input:deployAll}",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Deploy: Status",
      "detail": "Check the latest CD deploy workflow run status",
      "type": "shell",
      "command": "echo 'Recent deploy workflow runs:' && gh run list --workflow='CD: Deploy' --limit 5",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Deploy: Logs",
      "detail": "Stream logs from the most recent deploy workflow run",
      "type": "shell",
      "command": "node -e \"const{execSync:e}=require('child_process');const id=e('gh run list --workflow=\\\"CD: Deploy\\\" --limit 1 --json databaseId --jq \\\".[0].databaseId\\\"',{encoding:'utf-8'}).trim();e('gh run watch '+id,{stdio:'inherit'})\"",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": [],
      "isBackground": true
    },

