# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Parallel AI-tool agent configs — Claude Code (.claude/) is the single source of
# truth. These dirs are auto-generated by Nx/IDE tooling for other agents; keeping
# them tracked caused duplicate, drifting agent configs. Never commit them.
.cursor/
.opencode/
.windsurf/

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.nx/cache
.nx/workspace-data

# Local environment variables — never commit
.env.local
.env
.env.e2e
.env.github-local
.env.gh
*.code-workspace

# Domain/page spec scratch files under .specs/ — generated specs (domain-*.yaml,
# page-*.yaml) are gitignored by default; the README, schemas/, and the worked
# example-*.yaml are committed.
.specs/*.yaml
!.specs/example-*.yaml

# Playwright
playwright-report/
test-results/
**/.auth/

# Playwright visual baselines — platform-specific (font rendering differs
# between OSes), regenerated per consumer via:
#   pnpm nx e2e webapp-e2e -- --project=visual --update-snapshots
**/*-snapshots/

# Figma reference screenshots for /design-preview — project-specific
# artifacts of the consuming team's Figma file. Regenerated by the
# /figma-import workflow (Phase A.4.5) into:
#   apps/webapp/src/app/design-preview/figma-references/
apps/webapp/src/app/design-preview/figma-references/

.nx/polygraph

# Prisma generated client (platform-specific binaries, regenerated via prisma generate)
**/generated/client/

# Nx dependency graph export
graph.json

# SWC compiler cache
.swc/

# Next.js
.next
out

# TypeScript incremental build cache
*.tsbuildinfo

# Expo
node_modules/
.expo/
.yarn/
dist/
npm-debug.*
*.jks
*.p8
*.p12

# Examples workspace build/install artifacts (defense-in-depth — examples/.gitignore
# also covers these). The examples/ directory ships its own pnpm-workspace and
# Nx graph; install + build artifacts there should never be committed.
examples/node_modules/
examples/dist/
examples/out-tsc/
examples/coverage/
examples/.next/
examples/.nx/cache/
examples/.nx/workspace-data/
examples/tmp/
*.key
*.mobileprovision
*.orig.*
web-build/
cache/

# Terraform
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
infra/bootstrap/terraform.tfvars
infra/environments/monitoring/terraform.tfvars
infra/bootstrap/aws-credentials
infra/bootstrap/aws-credentials.*
!infra/bootstrap/aws-credentials.example
infra/bootstrap/github-secrets
infra/bootstrap/github-secrets.*
!infra/bootstrap/github-secrets.example

# Local-only helpdesk documentation (not for the repo)
/HELPDESK_DOCUMENTATION/


# Local-only LocalStack Pro override (contains nothing secret itself; token lives in .env)
docker-compose.override.yml

# Local-only scratch logs from `nx serve` / dynamodb-admin sessions
scratch-*.log
