# =============================================================================
# .env.local.example — committed template for local development
# =============================================================================
# This file is SAFE TO COMMIT. It contains no real secrets.
# All local values are identical for every developer.
#
# FIRST-TIME SETUP:
#   cp .env.local.example .env.local
#
# .env.local is gitignored — NEVER commit it.
# =============================================================================

# ─── Runtime mode ─────────────────────────────────────────────────────────────
# STAGE=local is the single source of truth for local-vs-AWS branching.
# NODE_ENV=production is intentional — NestJS production build runs locally.
# Do NOT change NODE_ENV to "development".
STAGE=local
NODE_ENV=production

# ─── LocalStack / Docker ──────────────────────────────────────────────────────
# Both DynamoDB and SQS are served by LocalStack on port 4566.
# Run: docker compose up -d  (see README §4)
DEFAULT_REGION=eu-west-2
LOCALSTACK_ENDPOINT=http://localhost:4566

# ─── DynamoDB ──────────────────────────────────────────────────────────────────
DYNAMODB_ENDPOINT=http://localhost:4566

# Fake credentials accepted by LocalStack — REMOVE before AWS deployment.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# ─── DynamoDB table names (per-domain) ────────────────────────────────────────

# ─── Service ports (HTTP API services only) ───────────────────────────────────
# Event-driven (SQS consumer) services do not have a port entry.
AUTH_SERVICE_PORT=3003
FILE_SERVICE_PORT=3004

# ─── API base URLs (consumed by frontend apps) ────────────────────────────────
API_AUTH_URL=http://localhost:3003/api
API_FILE_URL=http://localhost:3004/api

# ─── Frontend base URL (CORS, OAuth redirects) — one entry shared by all ──────
FE_BASE_URL=http://localhost:4200

# ─── Frontend (Next.js webapp) — NEXT_PUBLIC_ vars are exposed to the browser ─
NEXT_PUBLIC_API_AUTH_URL=http://localhost:3003/api
NEXT_PUBLIC_API_FILE_URL=http://localhost:3004/api
# /design-preview route — visible locally and in any env where this is "1".
# In production deploys leave blank to 404 the route.
NEXT_PUBLIC_ENABLE_DESIGN_PREVIEW=1


# ─── S3 (file storage) ────────────────────────────────────────────────────────
FILES_S3_BUCKET_NAME=mma-files

# ─── Cognito (auth domain — local uses mock provider, no real Cognito) ────────
# These are only needed in deployed environments. Leave empty for local dev.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_REGION=eu-west-2

# ─── SQS queues ───────────────────────────────────────────────────────────────
# Add per-domain SQS queue name + URL pairs here as you scaffold new domains.
# URL format: http://sqs.{DEFAULT_REGION}.localhost.localstack.cloud:4566/000000000000/{queue-name}
# The region segment MUST match DEFAULT_REGION above.

# ─── Figma (tokens sync + icon audit) ───────────────────────────────────────
# Personal access token — needed by `pnpm tokens:sync` and `pnpm figma:audit-icons`
# Get yours at: figma.com/settings → Personal access tokens
# FIGMA_ACCESS_TOKEN=figd_xxxxxxxxxxxxxxxx
#
# ── tokens:sync ──────────────────────────────────────────────────────────────
# Usage: pnpm tokens:sync --from-file ~/Downloads/variables.json
# (export variables.json from Figma using the Variable Gen JSON plugin)
#
# The bundled Cousteau design system uses `_Primitives` — set this in .env.local:
# FIGMA_PRIMITIVES_COLLECTION=_Primitives
# Override the mode name or group mapping only if your Figma file differs:
# FIGMA_LIGHT_MODE=Light
# FIGMA_COMPACT_PRIMITIVE_GROUPS='{"brand blue":"brand","error":"danger"}'
#
# ── figma:audit-icons ────────────────────────────────────────────────────────
# Usage: pnpm figma:audit-icons
# Comma-separated Figma file keys to scan for icon usage:
# FIGMA_AUDIT_FILES=TTph7X2aisVhdyb7Yos52X,w0CskJhTStXlnPDMxntFu9

# ─── Monitoring service (optional — only needed when running monitoring locally) ─
# The monitoring API + webapp are separate from the main app (independent deploy).
# Leave blank if you are not developing monitoring features locally.
MONITORING_API_PORT=8080
MONITORING_API_BASE_URL=http://localhost:8080
MONITORING_WEBAPP_URL=http://localhost:4300
MONITORING_JWT_SECRET=dev-monitoring-secret
# GitHub OAuth app (needed only for monitoring dashboard authentication locally)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REQUIRED_ORG=
# Used by monitoring-api-service to scope CloudWatch queries to this project
PROJECT_NAME=mma
TARGET_ENVIRONMENT=dev
# Next.js public API URL for monitoring webapp
NEXT_PUBLIC_MONITORING_API_URL=http://localhost:8080

# ─── OpenTelemetry (tracing) — leave blank to disable locally ─────────────────
# Setting OTEL_SDK_DISABLED=true disables all telemetry (no-op mode).
# In deployed envs, the ADOT Lambda layer exports to AWS X-Ray automatically.
OTEL_SDK_DISABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=
