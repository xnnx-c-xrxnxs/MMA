# Examples workspace local environment.
#
# Copy to .env.local and fill in. The examples workspace REUSES the same
# Docker / LocalStack / Postgres containers as the root (see ../docker-compose.yml),
# but creates additional tables/queues/databases scoped to the example domains.
#
# Populated during Phase 1.2-1.4 when example services + scripts are moved here.

# === Universal flags (mirror the root .env.local) ===
STAGE=local
NODE_ENV=production
DEFAULT_REGION=eu-west-2
LOCALSTACK_ENDPOINT=http://localhost:4566
DYNAMODB_ENDPOINT=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# === Example-domain ports + URLs ===
# (filled in during Phase 1.2 — placeholders below)
# USER_SERVICE_PORT=3000
# API_USER_URL=http://localhost:3000/api
# USERS_DYNAMODB_TABLE_NAME=OldSTTable
# ...
