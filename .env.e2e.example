# =============================================================================
# .env.e2e.example — E2E test environment (isolated from dev)
# =============================================================================
# Copy this file to .env.e2e for E2E testing:
#   cp .env.e2e.example .env.e2e
#
# E2E uses SEPARATE tables, databases, and queues so tests never
# interfere with manual development data. Same service ports are
# reused — E2E runs are not concurrent with dev.
#
# .env.e2e is gitignored — NEVER commit it.
# =============================================================================

# ─── Runtime mode ─────────────────────────────────────────────────────────────
STAGE=local
NODE_ENV=production

# ─── LocalStack / Docker ──────────────────────────────────────────────────────
DEFAULT_REGION=eu-west-2
LOCALSTACK_ENDPOINT=http://localhost:4566

# ─── DynamoDB ──────────────────────────────────────────────────────────────────
DYNAMODB_ENDPOINT=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# ─── Service ports (same as dev — E2E runs are not concurrent) ────────────────
AUTH_SERVICE_PORT=3003
FILE_SERVICE_PORT=3004

# ─── API base URLs ────────────────────────────────────────────────────────────
API_AUTH_URL=http://localhost:3003/api
API_FILE_URL=http://localhost:3004/api

# ─── Frontend base URL ────────────────────────────────────────────────────────
FE_BASE_URL=http://localhost:4200

# ─── Frontend (Next.js) — NEXT_PUBLIC_ vars exposed to browser ────────────────
NEXT_PUBLIC_API_AUTH_URL=http://localhost:3003/api
NEXT_PUBLIC_API_FILE_URL=http://localhost:3004/api

# ─── S3 bucket (E2E-isolated) ─────────────────────────────────────────────────
FILES_S3_BUCKET_NAME=files-e2e

# ─── Per-domain entries ───────────────────────────────────────────────────────
# Add DynamoDB table names, Prisma DATABASE_URLs, and SQS queue URL/name pairs
# here as you scaffold new domains. See examples/.env.e2e.example for the full
# reference implementation (user / product / order).
