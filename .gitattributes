# Mark generator-produced files as generated so GitHub collapses them by default
# in pull request diffs. Reviewers should focus on hand-written business logic
# (entities, use cases, repositories, custom controllers, contracts/event-schemas).
#
# To regenerate any of these, see the corresponding `nx g @old-st/nx-plugin:*`
# command logged at the top of each file.

# === Service scaffolding (apps/) ===
apps/*/*/src/main.ts                          linguist-generated=true
apps/*/*/src/app/**                           linguist-generated=true
apps/*/*/src/modules/**                       linguist-generated=true
apps/*/*/src/infrastructure/sqs/**            linguist-generated=true
apps/*/*/src/infrastructure/config/**         linguist-generated=true
apps/*/*/src/application/interfaces/normalized-sqs-record.interface.ts  linguist-generated=true
apps/*/*/src/application/interfaces/event-handler.interface.ts          linguist-generated=true
apps/*/*/src/presentation/pipes/zod-validation.pipe.ts                  linguist-generated=true
apps/*/*/src/presentation/decorators/current-user.decorator.ts          linguist-generated=true
apps/*/*/src/presentation/types/express.d.ts                             linguist-generated=true

# === Project tooling (regenerated by nx generators, never hand-edited) ===
apps/*/*/project.json                         linguist-generated=true
apps/*/*/tsconfig.json                        linguist-generated=true
apps/*/*/tsconfig.app.json                    linguist-generated=true
apps/*/*/tsconfig.spec.json                   linguist-generated=true
apps/*/*/jest.config.cts                      linguist-generated=true
apps/*/*/webpack.config.js                    linguist-generated=true

# === Domain package scaffolding (packages/*-domain) ===
packages/*-domain/project.json                linguist-generated=true
packages/*-domain/tsconfig.json               linguist-generated=true
packages/*-domain/tsconfig.lib.json           linguist-generated=true
packages/*-domain/tsconfig.spec.json          linguist-generated=true
packages/*-domain/jest.config.ts              linguist-generated=true
packages/*-domain/src/index.ts                linguist-generated=true

# === Contracts package scaffolding ===
packages/contracts/*/project.json             linguist-generated=true
packages/contracts/*/tsconfig.json            linguist-generated=true
packages/contracts/*/tsconfig.lib.json        linguist-generated=true
packages/contracts/*/package.json             linguist-generated=true

# === Generated Prisma clients (never reviewed) ===
packages/*-domain/src/infrastructure/generated/**  linguist-generated=true

# === Lockfiles (only changes via dependency updates) ===
pnpm-lock.yaml                                linguist-generated=true

# === Line endings ===
* text=auto eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
