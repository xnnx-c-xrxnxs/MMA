{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2022",
    "module": "esnext",
    "lib": ["es2022"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@mma/common": ["packages/common/src/index.ts"],
      "@mma/dynamodb-onetable": ["packages/dynamodb-onetable/src/index.ts"],
      "@mma/aws-secrets": ["packages/aws/aws-secrets/src/index.ts"],
      "@mma/aws-sqs": ["packages/aws/aws-sqs/src/index.ts"],
      "@mma/aws-cognito": ["packages/aws/aws-cognito/src/index.ts"],
      "@mma/aws-s3": ["packages/aws/aws-s3/src/index.ts"],
      "@mma/contracts/common": ["packages/contracts/common/src/index.ts"],
      "@mma/contracts/auth": ["packages/contracts/auth/src/index.ts"],
      "@mma/ui": ["packages/ui/src/index.ts"],
      "@mma/design-tokens": ["packages/design-tokens/src/index.ts"],
      "@mma/mobile-ui": ["packages/mobile-ui/src/index.ts"],
      "@mma/client-common": ["packages/client-common/src/index.ts"],
      "@mma/client-common/infrastructure": [
        "packages/client-common/src/infrastructure/index.ts"
      ],
      "@mma/client-common/hooks": ["packages/client-common/src/hooks/index.ts"],
      "@mma/telemetry": ["packages/telemetry/src/index.ts"],
      "@mma/monitoring-sdk": ["packages/monitoring-sdk/src/index.ts"],
      "@mma/eslint-plugin": ["packages/eslint-plugin/src/index.js"],
      "@mma/nx-plugin": ["packages/nx-plugin/src/index.ts"],
      "@mma/e2e-helpers": ["test/e2e/api-helpers.ts"],
      "@mma/customer-domain": ["packages/customer-domain/src/index.ts"],
      "@mma/customer-domain/infrastructure": [
        "packages/customer-domain/src/infrastructure/index.ts"
      ],
      "@mma/contracts/customer": ["packages/contracts/customer/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
